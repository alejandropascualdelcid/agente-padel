# Copia a .env y rellena. .env está en .gitignore: NUNCA lo subas al repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opcionales
INTERVAL_SECONDS=90
# Pausa entre consultas a Playtomic (segundos). Evita que Cloudflare bloquee con 403.
REQUEST_DELAY=0.5
STATE_FILE=state.json
CONFIG_FILE=config.local.json
# Clubes, días, franja y duración se configuran en config.json o desde el bot (/menu).
